# Copy to .env (gitignored) or set these in your shell. All are optional.
# The code reads them from the process environment; it does not auto-load .env.
#   PowerShell:  $env:QICAS_RESULTS = "results-alt"
#   bash/zsh:    export QICAS_RESULTS=results-alt

# Config YAML used by the CLI, dashboard and load_em_snapshot.py.
# Relative paths are resolved against the project root. Default: config/demo.yaml
QICAS_CONFIG=config/demo.yaml

# Folder for demo_run.json and figures/. Relative to the project root. Default: results
QICAS_RESULTS=results

# Electricity Maps API key. NOT read by any code today: scripts/load_em_snapshot.py works from
# CSV exports downloaded from https://www.electricitymaps.com/data-portal. Reserved for a future
# API-based loader. Never commit a real key.
ELECTRICITYMAPS_API_KEY=
